# Copy to .env in the repo root. Do not commit .env.

# Local research-demo mode. Keep 1 for the documented localhost walkthrough.
IRIS_DEMO_MODE=1

# Optional external assistant. Empty uses the local fallback.
DEEPSEEK_API_KEY=
IRIS_LLM_MODEL=deepseek-v4-flash-vision-exp

# Required for sensor ingest when IRIS_DEMO_MODE=0. In demo mode an empty
# value is allowed (loopback-only demonstration).
IRIS_DEVICE_TOKEN=

# Browser origin allowed by CORS. Do not use *.
WEB_ORIGIN=http://localhost:3000

# Optional SQLite override. Default is repository-local ignored storage.
# IRIS_DB=sqlite:///apps/api/storage/iris.db

# BMKG public forecast (https://data.bmkg.go.id/prakiraan-cuaca).
# adm4 = Kemendagri level-IV code from area_code_part1-4.pdf.
# Default is Kelurahan Salatiga, Kecamatan Sidorejo (33.73.01.1003).
BMKG_ADM4=33.73.01.1003
# Optional. The publik endpoint does not require a key.
# BMKG_API_KEY=
